##############################################################################
# .env.example — Copy to .env and fill in real values
# NEVER commit the real .env to git.
##############################################################################

# ── General ──────────────────────────────────────────────────────────────────

# Tenant slug (matches clients/<tenant>/ folder name)
TENANT=zenko

# Node environment: development | staging | production
NODE_ENV=development

# ── Backend ───────────────────────────────────────────────────────────────────

# Express port inside the container
PORT=3000

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# For Supabase (pooler):  postgresql://postgres.[project-ref]:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# For local compose:      postgresql://platform:devpassword@postgres:5432/platform_dev
DATABASE_URL=postgresql://platform:devpassword@postgres:5432/platform_dev

# Strong random secret — use: openssl rand -base64 48
JWT_SECRET=change-me-use-openssl-rand-base64-48

# ── Frontend (Vite) ───────────────────────────────────────────────────────────

# Passed as Docker build args at image build time
VITE_TENANT=zenko
VITE_API_URL=http://localhost:3000

# Optional: Vite dev server port on host
WEB_PORT=5173

# ── Local PostgreSQL (for docker-compose dev) ─────────────────────────────────
POSTGRES_USER=platform
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=platform_dev
POSTGRES_PORT=5432

# Path of the tenant's client folder (used by docker-compose to mount volumes)
TENANT_PATH=clients/zenko

# ── Integrations ──────────────────────────────────────────────────────────────

# Google Gemini API (AI assistant feature)
GEMINI_API_KEY=

# WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=

# ── Backups (S3-compatible) ───────────────────────────────────────────────────

# Use AWS S3, Cloudflare R2, Backblaze B2, Hetzner Object Storage, etc.
S3_ENDPOINT=https://s3.amazonaws.com
S3_REGION=us-east-1
S3_BUCKET=platform-backups
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# How many daily/weekly backup files to keep
BACKUP_RETAIN_DAILY=7
BACKUP_RETAIN_WEEKLY=4

# ── Docker / GHCR ────────────────────────────────────────────────────────────

# GitHub org/user for container registry
GITHUB_ORG=your-org

# Image tag used when pulling/pushing (set by CI to git SHA)
IMAGE_TAG=latest

# ── Coolify ───────────────────────────────────────────────────────────────────

# Your Coolify instance URL (no trailing slash)
COOLIFY_URL=https://coolify.yourdomain.com

# API token — generate in Coolify → Profile → API tokens
COOLIFY_API_TOKEN=

# UUID of the Coolify project that hosts all tenants
COOLIFY_PROJECT_UUID=

# UUID of the Hetzner server resource in Coolify
COOLIFY_SERVER_UUID=

# ── Traefik / TLS ─────────────────────────────────────────────────────────────

# Base domain under which tenants are hosted (e.g. <slug>.platform.com)
BASE_DOMAIN=yourplatform.com

# Let's Encrypt email (used by Traefik cert resolver)
LETSENCRYPT_EMAIL=admin@yourplatform.com

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// =============================================
// TENANTS — Multi-tenant registry
// =============================================

model Tenant {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("tenants")
}

// =============================================
// USERS — JWT Authentication
// =============================================

model User {
  id           String    @id @default(uuid())
  email        String?
  passwordHash String
  name         String
  role         String    @default("admin")  // "admin" | "viewer"
  tenantId     String                        // tenant slug or "all"
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  @@index([tenantId])
  @@map("users")
}

// =============================================
// CLIENTS — Shared registry (scoped by tenantId)
// =============================================

model Client {
  id        String    @id @default(uuid())
  name      String
  phone     String
  altPhone  String?
  tenantId  String                // tenant slug
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  garments       Garment[]
  patientRecords PatientRecord[]
  notifications  Notification[]

  @@unique([phone, tenantId])
  @@index([tenantId])
  @@map("clients")
}

// =============================================
// GARMENTS — Zenco garment repairs
// =============================================

model Garment {
  id          String    @id @default(uuid())
  tenantId    String
  orderNumber String                          // e.g. "ORD-001"
  clientId    String?
  clientName  String                          // denormalized for quick display
  clientPhone String
  repairType  String
  description String?
  status      String    @default("recibido")
  price       Float     @default(0)
  deposit     Float     @default(0)
  intakeDate  DateTime  @default(now())
  readyDate   DateTime?
  deliveredAt DateTime?
  notes       String?
  photos      GarmentPhoto[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  client      Client?   @relation(fields: [clientId], references: [id])

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, orderNumber])
  @@map("garments")
}

model GarmentPhoto {
  id        String   @id @default(uuid())
  garmentId String
  garment   Garment  @relation(fields: [garmentId], references: [id], onDelete: Cascade)
  filename  String
  url       String
  createdAt DateTime @default(now())

  @@index([garmentId])
  @@map("garment_photos")
}

// =============================================
// FINANCES — Unified tenant-scoped table
// =============================================

model Finance {
  id            String    @id @default(uuid())
  tenantId      String
  type          String    // "income" | "expense"
  amount        Float
  description   String
  category      String?
  paymentMethod String?
  referenceId   String?
  referenceType String?   // "order" | "appointment" | "manual"
  date          DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  @@index([tenantId])
  @@index([tenantId, date])
  @@index([tenantId, type])
  @@map("finances")
}

// =============================================
// APPOINTMENTS — MG Masajes bookings
// =============================================

model Appointment {
  id          String    @id @default(uuid())
  tenantId    String
  clientName  String
  clientPhone String
  service     String
  duration    Int
  date        String
  time        String
  status      String    @default("pendiente")
  price       Float
  notes       String?
  location    String    @default("Consultorio")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([tenantId])
  @@index([tenantId, date])
  @@index([tenantId, status])
  @@index([clientPhone])
  @@map("appointments")
}

// =============================================
// PATIENT RECORDS — Clinical history (MG Masajes)
// =============================================

model PatientRecord {
  id           String    @id @default(uuid())
  tenantId     String
  clientId     String
  client       Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  date         String
  reason       String
  symptoms     String?
  areas        String?
  treatment    String?
  observations String?
  nextSession  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@index([tenantId])
  @@index([clientId])
  @@map("patient_records")
}

// =============================================
// NOTIFICATIONS — WhatsApp / push alerts
// =============================================

model Notification {
  id        String    @id @default(uuid())
  tenantId  String
  clientId  String
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  message   String
  type      String    @default("prenda_lista")
  read      Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([tenantId])
  @@index([clientId])
  @@index([read])
  @@map("notifications")
}

// =============================================
// CHAT — AI assistant message history
// =============================================

model ChatMessage {
  id        String   @id @default(uuid())
  tenantId  String
  role      String   // "user" | "assistant"
  content   String
  sessionId String
  createdAt DateTime @default(now())

  @@index([tenantId, sessionId])
  @@map("chat_messages")
}

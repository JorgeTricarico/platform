{
  "permissions": {
    "allow": [
      "Bash(curl -sv \"https://platform-backend.onrender.com/health\")",
      "Bash(npm run:*)",
      "Bash(curl -s http://localhost:3000/health)",
      "Bash(node -e ':*)"
    ]
  },
  "mcpServers": {
    "engram": {
      "command": "/home/jorge/.local/bin/engram",
      "args": ["mcp", "--tools=agent"],
      "env": {
        "ENGRAM_DATA_DIR": "/home/jorge/Documents/Github/Platform/.engram",
        "ENGRAM_PROJECT": "platform"
      }
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/tdd-guard.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/tdd-tracker.sh"
          }
        ]
      }
    ]
  }
}

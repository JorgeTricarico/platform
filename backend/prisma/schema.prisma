generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =============================================
// CLIENTES — Registro compartido por negocio
// =============================================

model Client {
  id        String   @id @default(uuid())
  name      String
  phone     String
  altPhone  String?
  email     String?
  business  String               // "zenco" o "damian"
  notes     String?
  createdAt DateTime @default(now())

  @@unique([phone, business])
  @@map("clients")
}

// =============================================
// ZENCO — Arreglos de Ropa (Ana & Ariel)
// =============================================

model Order {
  id           String   @id
  clientName   String
  clientPhone  String
  garmentName  String
  repairType   String
  description  String
  status       String   @default("recibido")
  intakeDate   String   @default("")
  deliveryDate String
  price        Float
  location     String?
  createdAt    DateTime @default(now())
}

model GarmentPhoto {
  id         String   @id @default(uuid())
  garmentId  String
  filename   String
  url        String
  createdAt  DateTime @default(now())

  @@index([garmentId])
  @@map("garment_photos")
}

model ZencoFinance {
  id          String @id
  date        String
  type        String
  category    String
  amount      Float
  description String

  @@map("zenco_finances")
}

// =============================================
// DAMIAN — Masajes y Bienestar
// =============================================

model Appointment {
  id          String   @id
  clientName  String
  clientPhone String
  service     String
  duration    Int
  date        String
  time        String
  status      String   @default("pendiente")
  price       Float
  notes       String?
  location    String   @default("Consultorio")
  createdAt   DateTime @default(now())
}

model DamianFinance {
  id          String @id
  date        String
  type        String
  category    String
  amount      Float
  description String

  @@map("damian_finances")
}

// =============================================
// FICHAS CLINICAS — Historia clínica de pacientes (Damian)
// =============================================

model PatientRecord {
  id          String   @id @default(uuid())
  clientId    String
  date        String
  reason      String               // motivo de consulta
  symptoms    String?              // sintomas reportados
  areas       String?              // zonas trabajadas
  treatment   String?              // tratamiento aplicado
  observations String?             // observaciones del terapeuta
  nextSession String?              // indicaciones para proxima sesion
  createdAt   DateTime @default(now())

  @@index([clientId])
  @@map("patient_records")
}

// =============================================
// CHAT — Historial de mensajes por sesión
// =============================================

model ChatMessage {
  id        String   @id @default(uuid())
  business  String               // "zenco" o "damian"
  role      String               // "user" o "assistant"
  content   String
  sessionId String
  createdAt DateTime @default(now())

  @@index([business, sessionId])
  @@map("chat_messages")
}

// =============================================
// NOTIFICACIONES — Avisos a clientes (Zenco)
// =============================================

model Notification {
  id        String   @id @default(uuid())
  clientId  String
  message   String
  type      String   @default("prenda_lista")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([clientId])
  @@map("notifications")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// =============================================
// USUARIOS — Autenticación JWT
// =============================================

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("admin")  // "admin" | "viewer"
  business     String                       // "zenco" | "mg_masajes" | "all"
  createdAt    DateTime @default(now())

  @@map("users")
}

// =============================================
// CLIENTES — Registro compartido por negocio
// =============================================

model Client {
  id        String   @id @default(uuid())
  name      String
  phone     String
  altPhone  String?
  business  String               // "zenco" o "mg_masajes"
  createdAt DateTime @default(now())

  @@unique([phone, business])
  @@map("clients")
}

// =============================================
// ZENCO — Arreglos de Ropa (Ana & Ariel)
// =============================================

model Order {
  id           String   @id
  orderNumber  Int      @unique @default(autoincrement())
  clientName   String
  clientPhone  String
  garmentName  String
  repairType   String
  description  String
  status          String   @default("recibido")
  statusChangedAt String?
  intakeDate      String   @default("")
  deliveryDate String
  price        Float
  deposit      Float    @default(0)
  location     String?
  createdAt    DateTime @default(now())

  @@index([status])
  @@index([deliveryDate])
  @@map("orders")
}

model GarmentPhoto {
  id         String   @id @default(uuid())
  garmentId  String
  filename   String
  url        String
  createdAt  DateTime @default(now())

  @@index([garmentId])
  @@map("garment_photos")
}

model ZencoFinance {
  id          String @id
  date        String
  type        String
  category    String
  amount      Float
  description String

  @@index([date])
  @@map("zenco_finances")
}

// =============================================
// WELLNESS — MG Masajes y Salud
// =============================================

model Appointment {
  id          String   @id
  clientName  String
  clientPhone String
  service     String
  duration    Int
  date        String
  time        String
  status      String   @default("pendiente")
  price       Float
  notes       String?
  location    String   @default("Consultorio")
  createdAt   DateTime @default(now())

  @@index([date])
  @@map("appointments")
}

model MgMasajesFinance {
  id          String @id
  date        String
  type        String
  category    String
  amount      Float
  description String

  @@index([date])
  @@map("mg_masajes_finances")
}

// =============================================
// FICHAS CLINICAS — Historia clínica de pacientes
// =============================================

model PatientRecord {
  id          String   @id @default(uuid())
  clientId    String
  date        String
  reason      String               // motivo de consulta
  symptoms    String?              // sintomas reportados
  areas       String?              // zonas trabajadas
  treatment   String?              // tratamiento aplicado
  observations String?             // observaciones del terapeuta
  nextSession String?              // indicaciones para proxima sesion
  createdAt   DateTime @default(now())

  @@index([clientId])
  @@map("patient_records")
}

// =============================================
// CHAT — Historial de mensajes por sesión
// =============================================

model ChatMessage {
  id        String   @id @default(uuid())
  business  String               // "zenco" o "mg_masajes"
  role      String               // "user" o "assistant"
  content   String
  sessionId String
  createdAt DateTime @default(now())

  @@index([business, sessionId])
  @@map("chat_messages")
}

// =============================================
// NOTIFICACIONES — Avisos a clientes (Zenco)
// =============================================

model Notification {
  id        String   @id @default(uuid())
  clientId  String
  message   String
  type      String   @default("prenda_lista")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([clientId])
  @@map("notifications")
}
